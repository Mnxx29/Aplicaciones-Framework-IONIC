# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# Dependencies
**/node_modules/
node_modules/

# Compiled output
**/dist/
dist/
**/tmp/
tmp/
**/out-tsc/
**/.sourcemaps/
**/.versions/
**/coverage/

# Angular / Nx cache
**/.angular/
**/.nx/

# Ionic & Cordova & Capacitor
**/.ionic/
**/www/
**/platforms/
**/plugins/

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# OS and system files
.DS_Store
Thumbs.db
